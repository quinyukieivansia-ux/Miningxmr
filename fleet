#!/usr/bin/env bash
# ============================================================
# fleet - wrapper sederhana untuk kelola & monitor VPS worker
# Jalankan dari folder /root/fleet.
# ============================================================
cd "$(dirname "$0")" || exit 1

case "$1" in
  ping)
    ansible workers -m ping
    ;;
  list)
    ansible workers --list-hosts
    ;;
  health)
    ansible-playbook playbooks/health.yml
    ;;
  run)
    shift
    [ -z "$1" ] && { echo "Pakai: ./fleet run 'perintah'"; exit 1; }
    ansible-playbook playbooks/run-command.yml -e "cmd='$*'"
    ;;
  deploy)
    shift
    [ -z "$1" ] && { echo "Pakai: ./fleet deploy scripts/namafile.sh"; exit 1; }
    ansible-playbook playbooks/deploy-script.yml -e "src=$1"
    ;;
  collect)
    # Kumpulkan metrik semua VPS -> dashboard/data/metrics.json
    ansible-playbook playbooks/collect-metrics.yml
    ;;
  dashboard)
    # Jalankan web dashboard. Default port 8080.
    PORT="${2:-8080}"
    echo "Dashboard di http://0.0.0.0:${PORT}  (Ctrl+C untuk stop)"
    echo "Buka di browser: http://<IP-controller>:${PORT}"
    cd dashboard && python3 -m http.server "$PORT"
    ;;
  *)
    echo "fleet - kontrol & monitor armada VPS"
    echo ""
    echo "MANAGE:"
    echo "  ./fleet ping              Tes koneksi semua worker"
    echo "  ./fleet list              Daftar worker terdaftar"
    echo "  ./fleet run 'perintah'    Jalankan perintah di semua worker"
    echo "  ./fleet deploy file.sh    Kirim & jalankan script ke semua worker"
    echo ""
    echo "MONITOR:"
    echo "  ./fleet health            Ringkasan CPU/RAM/disk/uptime (teks)"
    echo "  ./fleet collect           Kumpulkan metrik ke JSON (buat dashboard)"
    echo "  ./fleet dashboard [port]  Jalankan dashboard web (default :8080)"
    echo ""
    echo "Tambah worker: edit inventory.ini"
    ;;
esac
